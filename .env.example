# NEXUS AI Studio - Production Environment Variables
PORT=3000
NODE_ENV=production

# OpenAI-Compatible Provider (GPT-5.6 Sol / GPT-6 Astra / Custom Endpoint)
OPENAI_BASE_URL=https://gpt.teamsoclo.site/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_KEY=your_openai_or_teamsoclo_api_key_here

# OpenRouter (Claude 3.5 Sonnet, DeepSeek R1)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini (Gemini 2.0 Flash, Imagen 3)
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Telefon OTP (SMS) ---
# Eskiz.uz orqali SMS yuborish (ixtiyoriy). Sozlanmasa, kod server logida chiqadi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# true bo'lsa va SMS provayder sozlanmagan bo'lsa, kod javobda ham ko'rsatiladi (faqat test uchun)
OTP_DEV_MODE=true

# --- Telegram (ixtiyoriy, qo'shimcha kirish usuli) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=@renaxaiuz_bot
