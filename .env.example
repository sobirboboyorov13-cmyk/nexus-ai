# NEXUS AI Studio - Production Environment Variables
PORT=3000
NODE_ENV=production

# OpenAI-Compatible Provider (GPT-5.6 Sol / GPT-6 Astra / Custom Endpoint)
OPENAI_BASE_URL=https://gpt.teamsoclo.site/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_KEY=your_openai_or_teamsoclo_api_key_here

# OpenRouter (Claude 3.5 Sonnet, DeepSeek R1)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini (Gemini 2.0 Flash, Imagen 3)
GEMINI_API_KEY=your_google_gemini_api_key_here
